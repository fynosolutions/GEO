# Copy to .env. Never put this key in frontend files or commit .env.
OPENAI_API_KEY=
# Must support Responses API web_search and structured outputs in your account.
OPENAI_MODEL=gpt-5.4
HOST=127.0.0.1
PORT=3001
AUDIT_DATA_DIR=.local/audits
# Optional explicit proxy; otherwise the enabled Windows system proxy is used.
# HTTPS_PROXY=http://127.0.0.1:7890
BROWSER_FALLBACK=true
# Uses installed Edge on Windows. Set chromium on hosts with Playwright Chromium installed.
BROWSER_CHANNEL=msedge
BROWSER_HEADLESS=true
# Dedicated, platform-separated persistent sessions (never use a personal browser profile).
BROWSER_PROFILE_DIR=.local/browser-profiles
# Passive wait for normal JS/redirects; 0–120000ms. Does not solve CAPTCHA.
BROWSER_SETTLE_TIMEOUT_MS=45000
VISION_FALLBACK=true
# Final independent question + web search when no fields were recovered (2 API calls).
QUESTION_FALLBACK=true
# Search actual platform reviews when review_themes is still missing (2 extra calls).
REVIEW_THEMES_FALLBACK=true
# Optional additional provider. Runs configured Actors even when older paths have data.
APIFY_TOKEN=
APIFY_ENABLED=true
APIFY_CONFIG_FILE=config/apify.json
# Per run; provider/platform billing rules still apply. Not an overall monthly cap.
APIFY_MAX_CHARGE_USD=0.50
# Optional model supporting image inputs; defaults to OPENAI_MODEL.
# OPENAI_VISION_MODEL=gpt-5.4
# Optional separate browser proxy; defaults to HTTPS_PROXY/system proxy.
# BROWSER_PROXY=http://127.0.0.1:7890

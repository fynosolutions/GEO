# Copy to .env; never commit credentials or runtime data.
APIFY_TOKEN=
APIFY_ENABLED=true
APIFY_CONFIG_FILE=config/apify.json
# Per Actor run, not the total job cost.
APIFY_MAX_CHARGE_USD=0.50
OUTPUT_DIR=out
COLLECTION_DATA_DIR=.local/collections
AUDIT_DATA_DIR=.local/audits
HOST=127.0.0.1
PORT=3001
BROWSER_FALLBACK=false
BROWSER_CHANNEL=chromium
BROWSER_HEADLESS=true
BROWSER_PROFILE_DIR=.local/browser-profiles
BROWSER_SETTLE_TIMEOUT_MS=15000
# Optional proxy for Node fetch / browser; no Windows registry dependency.
# HTTPS_PROXY=http://127.0.0.1:7890
# BROWSER_PROXY=http://127.0.0.1:7890
# Existing optional access-token gate; leave empty for the loopback-only local UI.
GEO_API_TOKEN=
COOKIE_SECURE=false

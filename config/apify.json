  "doordash":{"actor":"memo23/doordash-reviews-cheerio","input":{"startUrls":[{"url":"{{listing_url}}"}],"region":"US","maxItems":1,"maxConcurrency":1,"maxRequestRetries":1}},
  "opentable":{"actor":"s-r/opentable-scraper","input":{"search_term":"{{name}}","city":"{{city}}","domain":"com","limit":1,"include_reviews":false}},
  "grubhub":{"actor":"natanielsantos/grubhub-scraper","input":{"urls":["{{listing_url}}"],"maxItems":1,"scrapeAvailableHours":true}},

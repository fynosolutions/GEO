{
  "yelp": {"actor":"epctex/yelp-business-api","input":{"startUrls":["{{listing_url}}"],"maxItems":1}},
  "google_maps": {"actor":"compass/crawler-google-places","input":{"searchStringsArray":["{{name}} {{address}}"],"maxCrawledPlacesPerSearch":1,"language":"en"}},
  "tripadvisor": {"actor":"maxcopell/tripadvisor","input":{"startUrls":[{"url":"{{listing_url}}"}],"maxItemsPerQuery":1,"language":"en"}},

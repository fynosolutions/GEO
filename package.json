{
  "name": "geo-checker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Restaurant listing collector producing out/<restaurant-name>.json",
  "scripts": {
    "build": "tsc -p config/tsconfig.server.json && tsc -p config/tsconfig.client.json && node scripts/copy-assets.mjs",
    "check": "tsc -p config/tsconfig.server.json --noEmit && tsc -p config/tsconfig.client.json --noEmit",
    "start": "node dist/backend/server.js",
    "test": "node --test scripts/*.test.mjs",
    "prebuild": "node scripts/check-runtime.mjs && node scripts/clean-dist.mjs",
    "precheck": "node scripts/check-runtime.mjs",
    "prestart": "node scripts/check-runtime.mjs",
    "pretest": "node scripts/check-runtime.mjs",
    "collect": "node dist/backend/cli.js",
    "precollect": "node scripts/check-runtime.mjs",
    "collect:weekly": "node dist/backend/weekly/cli.js",
    "precollect:weekly": "node scripts/check-runtime.mjs",
    "collect:details": "node dist/backend/menu-audit/cli.js",
    "apify:check": "node scripts/apify-check.mjs",
    "deploy:check": "node scripts/deploy-preflight.mjs",
    "collect:reviews": "node dist/backend/reviews/cli.js",
    "precollect:reviews": "node scripts/check-runtime.mjs"
  },
  "engines": {
    "node": ">=24.14.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.1.0",
    "cheerio": "^1.2.0",
    "pdfjs-dist": "^6.5.438",
    "playwright": "^1.64.1",
    "tesseract.js": "^7.0.0"
  }
}

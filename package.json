{
  "name": "geo-checker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Restaurant listing collector producing out/<restaurant-name>.json",
  "scripts": {
    "build": "tsc -p config/tsconfig.server.json && tsc -p config/tsconfig.client.json && node scripts/copy-assets.mjs",
    "check": "tsc -p config/tsconfig.server.json --noEmit && tsc -p config/tsconfig.client.json --noEmit",
    "start": "node dist/backend/server.js",
    "test": "node --test scripts/*.test.mjs",
    "prebuild": "node scripts/check-runtime.mjs && node scripts/clean-dist.mjs",
    "precheck": "node scripts/check-runtime.mjs",
    "prestart": "node scripts/check-runtime.mjs",
    "pretest": "node scripts/check-runtime.mjs",
    "collect": "node dist/backend/cli.js",
    "precollect": "node scripts/check-runtime.mjs"
  },
  "engines": {
    "node": ">=24.14.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "playwright": "^1.64.1"
  }
}

{
  "name": "geobase",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/next.mjs dev --webpack --hostname 127.0.0.1",
    "build": "node scripts/next.mjs build --webpack",
    "start": "node scripts/next.mjs start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "tsx src/infrastructure/database/migrate.ts",
    "db:generate": "node scripts/generate-migration.mjs",
    "seed:demo": "tsx tests/seed-demo.ts",
    "format": "prettier --write src tests scripts *.ts *.json",
    "format:check": "prettier --check src tests scripts *.ts *.json",
    "test:capacity": "tsx tests/capacity.ts"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.5.0",
    "@tailwindcss/postcss": "4.3.3",
    "archiver": "8.0.0",
    "better-sqlite3": "13.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.59.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/archiver": "8.0.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/yauzl": "3.4.0",
    "drizzle-kit": "0.31.11",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "overrides": {
    "esbuild": "0.28.2"
  },
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  }
}

# Copy the required values into both root .env and apps/web/.env; never commit real keys.
# Queries are disabled by default. Obtain API access and confirm its permitted purpose first.
GEO_GOOGLE_PLACES_ENABLED=false
GEO_GOOGLE_PLACES_API_KEY=
# Positive USD ceiling per request, at most 6 decimal places. Include all requested fields/SKUs.
GEO_GOOGLE_MAX_REQUEST_USD=
GEO_YELP_API_KEY=
# evaluation for authorized evaluation only, or display_authorized for separately permitted display.
# Neither option enables analysis, snapshots, reports or weekly monitoring.
GEO_YELP_PURPOSE=
GEO_YELP_MAX_REQUEST_USD=
# Verified project external spend outside the new reservation ledger. Required even if 0.
# Include subscriptions and other services. Do not count new reservations twice.
GEO_PLATFORM_PRIOR_SPEND_USD=

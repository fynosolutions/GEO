# Copy to .env; restrict permissions to the server operator. No real keys here.
GEO_AUDIT_IMAGE=geo-restaurant-audit:v1
AUDIT_DOMAIN=reports.example.com
ACME_EMAIL=operator@example.com
APP_URL=https://reports.example.com
VITE_APP_URL=https://reports.example.com
POSTGRES_USER=elmo
POSTGRES_DB=restaurant_audits
# Use a generated hex password (URL-safe).
POSTGRES_PASSWORD=REPLACE_WITH_GENERATED_HEX_PASSWORD
# Existing deployments only: add compose.existing-db.yaml and use the SAME
# database as the original web/worker so all providers share one budget ledger.
# The hostname must already be reachable on an approved private container network.
# AUDIT_EXISTING_DATABASE_URL=postgresql://PRIVATE_USER:PRIVATE_PASSWORD@PRIVATE_HOST:5432/EXISTING_DATABASE
BETTER_AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
ELMO_ENCRYPTION_KEY=REPLACE_WITH_BASE64_FOR_EXACTLY_32_BYTES

# The project cap is fixed in code at US$20 cumulative, including prior spend.
# Do not set AUDIT_TEST_MODE or NODE_ENV=test on this deployment.
PUBLIC_AUDIT_ENABLED=0
PUBLIC_AUDIT_LIVE_CALLS_ENABLED=0
PUBLIC_AUDIT_WORKER_ONLY=1
AUDIT_SHARED_BUDGET_ENABLED=0
AUDIT_TRUST_PROXY=1
AUDIT_STORAGE_DIR=/var/lib/elmo-audits
GEO_PROJECT_ROOT=/app/repos/Elmo
GEO_PYTHON=/usr/bin/python3
PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
GEO_PIPELINE_ENABLED=0
SCRAPE_TARGETS=stub:stub
ONBOARDING_LLM_TARGET=stub:stub
DISABLE_TELEMETRY=1
DEPLOYMENT_MODE=local

OPENAI_API_KEY=
OPENROUTER_API_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=Restaurant Reports <reports@example.com>
# Set only after a human reviews current model/search prices and capabilities.
# ISO UTC timestamp, no older than seven days. Empty means paid work stays off.
AUDIT_PRICE_REVIEWED_AT=
# Separate opt-in for the operator's quality collection CLI.
AUDIT_EVALUATION_LIVE_ENABLED=0
# Generated from >=60 attributable human labels and budget-accounted model
# judgments. The host directory is mounted read-only; do not handwrite a pass.
AUDIT_QUALITY_EVIDENCE_FILE=/run/audit-quality/quality-evidence.json
GEO_PLATFORM_PRIOR_SPEND_USD=0
